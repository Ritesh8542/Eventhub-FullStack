# Copy to .env and fill in your own values. NEVER commit a real .env.
PORT=5000
JWT_SECRET=change-me-to-a-long-random-secret
# Leave blank to run WITHOUT MongoDB (in-memory store is used).
# Set to MongoDB Atlas / local URI to use a real database, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/eventhub
MONGODB_URI=
# AWS (optional for local run). Leave blank for local file uploads.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
CLIENT_URL=http://localhost:5173
